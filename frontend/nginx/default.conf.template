# Rendered at container start by the image's envsubst step (only ^API_ variables).
server {
    listen 8502;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Largest ingest body: ceil(20 MiB * 4/3) = 27,962,027 bytes plus JSON overhead.
    client_max_body_size 30m;
    client_body_timeout 120s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # No URI on proxy_pass: the request URI (encoding included) goes upstream as sent.
    location /api/v1/ {
        proxy_pass http://${API_HOST}:${API_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        include /etc/nginx/security-headers.conf;
    }

    location = /api/health {
        proxy_pass http://${API_HOST}:${API_PORT}/health;
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        include /etc/nginx/security-headers.conf;
    }

    location /api/ {
        return 404;
        include /etc/nginx/security-headers.conf;
    }

    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/security-headers.conf;
    }

    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/security-headers.conf;
    }
}
